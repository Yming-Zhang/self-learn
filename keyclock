配置文件
spring.security.oauth2.resourceserver.jwt.issuer-uri=http://localhost:8080/realms/erd-page
这个必须得配。要不然检测不到，不回家在jwtdecoder bean，启动会报错
引入的这个资源可以根据这个url自动拿到信息来解析keycloak的token
配置上token解析filter
/**
 * spring security配置
 */
@EnableMethodSecurity(prePostEnabled = true, securedEnabled = true)
@Configuration
public class SecurityConfig {

@Bean
@Order(1)
public SecurityFilterChain keycloakLoginFilterChain(HttpSecurity http) throws Exception {
    http
            .securityMatcher("/auth/login") // 仅匹配auth/login
            .csrf(csrf -> csrf.disable())
            .sessionManagement(sm -> sm.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
            .authorizeHttpRequests(auth -> auth
                    .requestMatchers("/auth/login").permitAll()
                    .anyRequest().denyAll()
            )
            .oauth2ResourceServer(oauth2 -> oauth2.jwt(Customizer.withDefaults())) // 启用Keycloak Jwt自动校验
            .exceptionHandling(ex -> ex.authenticationEntryPoint(unauthorizedHandler))
    ;
    // 可选加CORS
    http.addFilterBefore(corsFilter, UsernamePasswordAuthenticationFilter.class);
    return http.build();
}
